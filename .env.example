# ── Servidor ──────────────────────────────────────────────────────
# Puerto en el que escucha el servidor Express
PORT=3001

# Entorno de ejecución: "production" o "development"
NODE_ENV=production

# Ruta al archivo SQLite (en producción usa un volumen persistente)
DB_PATH=./server/data.sqlite

# ── Seguridad ─────────────────────────────────────────────────────
# Origen permitido para CORS (tu dominio público).
# Deja vacío para permitir todos los orígenes (solo en desarrollo).
# Ejemplo: https://bufferapp.fly.dev
CORS_ORIGIN=
